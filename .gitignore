# 公开仓库只跟踪明确列出的代码、文档、配置和版本参考。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pytest.ini
!/requirements-*.txt
!/run_all_preliminary_experiments.py
!/src/
!/tests/
!/tools/
!/docs/
!/config/
!/progress/
!/outputs/

# 本地实验配置可能包含私有材料路径。
/config/*
!/config/experiment.example.json
!/config/model_smoke*.json
!/config/pilot_*.json
!/config/sprint2_fixed_annotation_v*.json

/progress/*
!/progress/dashboard.template.html
!/progress/run.example.json

/outputs/*
!/outputs/method_repair/
/outputs/method_repair/*
!/outputs/method_repair/provisional_split.json

__pycache__/
.pytest_cache/
*.py[cod]
.env
.env.*
*.pem
*.key
